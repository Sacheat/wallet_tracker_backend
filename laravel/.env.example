APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set MAIL_MAILER=resend and MAIL_FROM_ADDRESS=onboarding@resend.dev (or a
# verified domain) to actually send price alert / digest emails.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URLS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173,127.0.0.1:8000

# Production (Sanctum cookie-SPA): the browser must see the frontend and the
# API as the same site, otherwise the session cookie is treated as
# third-party and login silently fails. Two layouts work:
# - own domain: app.domaine.fr + api.domaine.fr, SESSION_DOMAIN=.domaine.fr
# - free hosting (current deployment): the Vercel frontend proxies backend
#   calls to alwaysdata through vercel.json rewrites, so the browser only
#   ever talks to the vercel.app host. vercel.app and alwaysdata.net are
#   both public suffixes: a direct cross-host call would be cross-site.
# Current deployment (alwaysdata + Vercel proxy):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://wallet-tracker-frontend-ten.vercel.app/backend
# Same value as the Vercel env var the vercel.json transform sends as
# X-Proxy-Secret; any request without it is rejected (403). Generate with
# `openssl rand -hex 32`.
# PROXY_SECRET=
# DB_CONNECTION=mariadb
# DB_HOST=mysql-pftracker.alwaysdata.net
# DB_PORT=3306
# DB_DATABASE=pftracker_app
# DB_USERNAME=pftracker
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# FRONTEND_URLS=https://wallet-tracker-frontend-ten.vercel.app
# SANCTUM_STATEFUL_DOMAINS=wallet-tracker-frontend-ten.vercel.app
# Rotated daily, kept 14 days: the retention the privacy policy states.
# LOG_STACK=daily
# LOG_DAILY_DAYS=14
# LOG_LEVEL=warning
COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=
GEMINI_API_KEY=
MARKETAUX_API_KEY=
